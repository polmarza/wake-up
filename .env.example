# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca debe llegar al cliente: salta el RLS.
SUPABASE_SECRET_KEY=
# Conexión directa, para migraciones y seed.
DATABASE_URL=

# ─── Claude API ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
# Firma del webhook de rebotes, quejas y bajas.
RESEND_WEBHOOK_SECRET=

# ─── Guardarraíles de envío ───────────────────────────────────────────────────
# Interruptor de seguridad. En false, ningún email sale al exterior aunque se
# llame directamente a la acción de envío. Activar solo para la prueba real.
ENVIO_REAL_HABILITADO=false
# Única dirección que puede recibir envíos reales de prueba.
EMAIL_OPERADOR=

# ─── Alumno real (para la demo) ───────────────────────────────────────────────
# El dataset es sintético y sus correos son @example.com, no entregables. Si defines
# estas variables, el seed añade un alumno más con datos reales para poder ver un
# email de verdad. Si no pones ALUMNO_REAL_EMAIL se usa EMAIL_OPERADOR.
#
# ALUMNO_REAL_EMAIL y EMAIL_OPERADOR son las DOS únicas direcciones que pueden
# recibir un envío real. Cualquier otra queda bloqueada.
ALUMNO_REAL_NOMBRE=
ALUMNO_REAL_APELLIDOS=
ALUMNO_REAL_EMAIL=

# ─── Tests ────────────────────────────────────────────────────────────────────
# Base de datos SEPARADA para los tests de la política de supresión. Nunca apuntar
# a la de desarrollo: los tests crean y modifican alumnos.
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Quién puede entrar al panel, separado por comas. Admite tres formatos:
#   ana@learningheroes.com   una dirección concreta
#   @learningheroes.com      cualquier dirección de ese dominio
#   learningheroes.com       igual que la anterior
# Si se deja vacío no entra nadie: falla cerrado a propósito.
EMAILS_PERMITIDOS=

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Protege /api/cron/preparar-cola. Sin este valor el endpoint devuelve 401.
CRON_SECRET=

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# Credenciales que consumen los servidores declarados en .mcp.json.
# En .mcp.json van referenciadas como ${VARIABLE}; el valor real vive aquí.
# Rellenar solo las de los servidores que se acaben configurando (ver /mcp-setup).
# SUPABASE_ACCESS_TOKEN=
# VERCEL_API_TOKEN=
